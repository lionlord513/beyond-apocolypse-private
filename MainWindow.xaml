<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Beyond Mod Manager" Width="1240" Height="840" MinWidth="1020" MinHeight="720" Background="#151714" Foreground="#F0EADF" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen" AllowDrop="True">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#AAAFA2"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Eyebrow" TargetType="TextBlock"><Setter Property="Foreground" Value="#A8B090"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="Bold"/></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#2B3027"/><Setter Property="Foreground" Value="#F0EADF"/><Setter Property="BorderBrush" Value="#454B3C"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="15,10"/><Setter Property="MinHeight" Value="38"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#B2BC8A"/><Setter TargetName="Face" Property="Background" Value="#3A4233"/><Setter Property="Foreground" Value="#F0EADF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#B2BE8A"/><Setter Property="Foreground" Value="#181D13"/><Setter Property="BorderBrush" Value="#B2BE8A"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#161A15"/><Setter Property="Foreground" Value="#E1DFD3"/><Setter Property="BorderBrush" Value="#42483A"/><Setter Property="Padding" Value="12,9"/><Setter Property="CaretBrush" Value="#D6DBBD"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#EEE9DE"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Padding" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemFace" Background="#21251E" BorderBrush="#343B2C" BorderThickness="1" CornerRadius="7" Padding="14"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemFace" Property="Background" Value="#303A28"/><Setter TargetName="ItemFace" Property="BorderBrush" Value="#8B9B65"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemFace" Property="BorderBrush" Value="#89956D"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid x:Name="Root">
  <Grid.ColumnDefinitions><ColumnDefinition Width="196"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border x:Name="Navigation" Background="#1D211A" BorderBrush="#343A2E" BorderThickness="0,0,1,0">
   <DockPanel Margin="20,26,20,22">
    <StackPanel DockPanel.Dock="Top">
     <Grid Width="58" Height="58" HorizontalAlignment="Left" Margin="0,0,0,14"><Border Background="#B2BE8A" CornerRadius="12"/><Path Data="M 11,44 L 17,15 L 29,31 L 41,15 L 47,44 M 28,43 L 29,37" Stroke="#202719" StrokeThickness="5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Grid>
     <TextBlock Text="BEYOND" FontSize="22" FontWeight="Bold"/><TextBlock Text="MOD MANAGER" Style="{StaticResource Eyebrow}" Margin="1,3,0,32"/>
     <Button x:Name="ModsPageButton" Content="My mods" Margin="0,0,0,10"/>
     <Button x:Name="ActivityPageButton" Content="Activity" Margin="0,0,0,10"/>
     <Button x:Name="SettingsPageButton" Content="Settings"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
     <TextBlock Text="BUILT FOR THE ROAD" Style="{StaticResource Eyebrow}"/>
     <TextBlock Text="Drive Beyond Horizons" FontSize="12" Margin="0,7,0,4"/>
     <TextBlock x:Name="ManagerVersion" Text="BMM 1.0.3" Style="{StaticResource Muted}"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid x:Name="Workspace" Grid.Column="1" Margin="27,23,27,18">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="YOUR NEXT JOURNEY" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="PageTitle" Text="My mods" FontSize="29" FontWeight="SemiBold" Margin="0,4,0,2"/><TextBlock x:Name="GameState" Text="Choose your game folder to get started" Style="{StaticResource Muted}"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="AddZipButton" Content="+  Add ZIP" Margin="0,0,9,0"/><Button x:Name="PlayButton" Content="Play game" Style="{StaticResource Primary}"/></StackPanel>
   </Grid>
   <Grid Grid.Row="1">
    <Grid x:Name="ModsPage"><Grid.ColumnDefinitions><ColumnDefinition Width="278"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,12"><Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Refresh" Padding="10,5" MinHeight="28" FontSize="11"/><TextBlock x:Name="ModCount" Text="YOUR COLLECTION" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/></DockPanel>
      <ListBox x:Name="ModList" Grid.Row="1"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Subtitle}" Foreground="#B8BCA9" FontSize="11" Margin="0,6,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
      <Border Grid.Row="2" Padding="15" BorderBrush="#454D3A" BorderThickness="1" CornerRadius="7" Margin="0,12,0,0"><StackPanel><TextBlock Text="Drop your mod ZIP here" FontWeight="SemiBold"/><TextBlock Text="Or drop anywhere in this window. Choose Install to add it." Style="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel></Border>
     </Grid>
     <Border Grid.Column="2" Background="#1D221B" BorderBrush="#363E30" BorderThickness="1" CornerRadius="10">
      <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="24">
        <Border x:Name="ModArtwork" Height="155" Background="#272D21" CornerRadius="7" Margin="0,0,0,20"><Grid ClipToBounds="True"><Path Data="M -50,190 L 160,-30 M 10,205 L 220,-30 M 355,200 L 565,-30" Stroke="#7D8B5D" StrokeThickness="24" Opacity="0.07"/><Image x:Name="ModLogo" Margin="18" Stretch="Uniform"/><TextBlock x:Name="ModInitials" Text="MOD" FontSize="46" Foreground="#B2BE8A" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
        <TextBlock x:Name="DetailType" Text="FEATURED MOD" Style="{StaticResource Eyebrow}"/>
        <TextBlock x:Name="DetailName" Text="Beyond Apocalypse" FontSize="26" FontWeight="SemiBold" Margin="0,5,0,6"/>
        <TextBlock x:Name="DetailVersion" Text="Public release 1.0.5" Foreground="#BCC79A" FontSize="12"/>
        <TextBlock x:Name="DetailDescription" Margin="0,16,0,14" Foreground="#D0D3C4" LineHeight="21"/>
        <Border x:Name="ManagedNoteBox" Background="#2D2C20" CornerRadius="5" Padding="12" Margin="0,0,0,15"><TextBlock x:Name="ManagedNote" Foreground="#D6CBA7" FontSize="12"/></Border>
        <TextBlock x:Name="UpdateStatus" Foreground="#B6C395" FontSize="12" Margin="0,0,0,14"/>
        <TextBlock x:Name="RequirementsText" Foreground="#AAB39A" FontSize="11" Margin="0,0,0,16"/>
        <TextBlock x:Name="HistoryHeading" Text="RELEASE HISTORY" Style="{StaticResource Eyebrow}" Margin="0,0,0,12"/>
        <TextBlock x:Name="DetailHistory" Foreground="#CDD1C0" FontSize="12" LineHeight="19"/>
        <TextBlock x:Name="ReadmeHeading" Text="PACKAGE README" Style="{StaticResource Eyebrow}" Margin="0,20,0,10"/>
        <TextBlock x:Name="DetailReadme" Foreground="#BCC3AC" FontSize="12" LineHeight="18"/>
       </StackPanel></ScrollViewer>
       <Border Grid.Row="1" BorderBrush="#363E30" BorderThickness="0,1,0,0" Padding="16"><WrapPanel><Button x:Name="UpdateModButton" Content="Check for update" Style="{StaticResource Primary}" Margin="0,0,8,7"/><Button x:Name="ToggleModButton" Content="Disable" Margin="0,0,8,7"/><Button x:Name="UninstallModButton" Content="Uninstall" Margin="0,0,8,7"/><Button x:Name="OpenModFolderButton" Content="Folder" Margin="0,0,0,7"/></WrapPanel></Border>
      </Grid>
     </Border>
    </Grid>
    <Grid x:Name="ActivityPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,16"><Button x:Name="OpenLogButton" DockPanel.Dock="Right" Content="Open log"/><TextBlock Text="Installations, updates and changes appear here." Style="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel><TextBox x:Name="ActivityText" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/></Grid>
    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="GAME LOCATION" Style="{StaticResource Eyebrow}"/><TextBlock Text="Your Drive Beyond Horizons folder" FontSize="19" FontWeight="SemiBold" Margin="0,7,0,12"/>
     <DockPanel><Button x:Name="BrowseGameButton" DockPanel.Dock="Right" Content="Browse" Margin="10,0,0,0"/><TextBox x:Name="GamePathText" IsReadOnly="True" VerticalContentAlignment="Center"/></DockPanel>
     <TextBlock Text="The folder that contains DriveBeyondHorizons.exe. Steam installations are detected automatically." Style="{StaticResource Muted}" Margin="0,9,0,24"/>
     <Border Background="#22281E" CornerRadius="8" Padding="19" Margin="0,0,0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,15,0"><TextBlock Text="Manager updates" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Update BMM independently from your mods." Style="{StaticResource Muted}" Margin="0,7,0,0"/><TextBlock x:Name="ManagerUpdateStatus" Foreground="#B6C395" FontSize="12" Margin="0,8,0,0"/></StackPanel><Button x:Name="ManagerUpdateButton" Grid.Column="1" Content="Check for updates" VerticalAlignment="Center"/></Grid></Border>
     <TextBlock Text="FILES AND RECOVERY" Style="{StaticResource Eyebrow}" Margin="0,0,0,12"/><WrapPanel><Button x:Name="OpenGameFolderButton" Content="Game folder" Margin="0,0,10,10"/><Button x:Name="OpenBackupsButton" Content="Backups" Margin="0,0,10,10"/><Button x:Name="OpenManagerFolderButton" Content="Manager data" Margin="0,0,10,10"/></WrapPanel>
     <TextBlock Text="Mod settings and shared support files are retained when removing a mod. Installation backups are kept in manager data." Style="{StaticResource Muted}" Margin="0,0,0,24"/>
     <Expander x:Name="CreatorSection" Header="For mod creators" Foreground="#D4D8C5" FontSize="15"><StackPanel Margin="0,15,0,0"><TextBox x:Name="CreatorHelp" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="350" FontSize="13"/><Button x:Name="CopyExampleButton" Content="Copy example bmm.json" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Expander>
    </StackPanel></ScrollViewer>
   </Grid>
   <StackPanel Grid.Row="2" Margin="0,17,0,0"><ProgressBar x:Name="Progress" Height="3" Background="#262E21" Foreground="#B2BE8A" IsIndeterminate="False" Visibility="Collapsed" Margin="0,0,0,10"/><TextBlock x:Name="Status" Text="Ready. Add a mod ZIP to get started." Foreground="#B3BAA6" FontSize="12" TextTrimming="CharacterEllipsis" MaxHeight="40"/></StackPanel>
  </Grid>
  <Border x:Name="ImportOverlay" Grid.ColumnSpan="2" Background="#DC10130F" Visibility="Collapsed">
   <Border Background="#242B20" BorderBrush="#5E704C" BorderThickness="1" CornerRadius="12" Width="720" MaxHeight="665" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="INSTALL MOD" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="PreviewName" TextWrapping="Wrap" FontSize="27" FontWeight="SemiBold" Margin="0,9,0,8"/><TextBlock x:Name="PreviewSummary" Style="{StaticResource Muted}" Margin="0,0,0,20"/></StackPanel>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="380"><StackPanel><TextBlock x:Name="PreviewDescription" TextWrapping="Wrap" Foreground="#D9DECA" LineHeight="23" Margin="0,0,0,15"/><TextBlock x:Name="PreviewDependencies" TextWrapping="Wrap" Foreground="#DDC8A0" LineHeight="20"/><TextBlock Text="Close the game before installing. Your settings and saves are kept." Style="{StaticResource Muted}" Margin="0,16,0,0"/></StackPanel></ScrollViewer>
     <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,23,0,0"><Button x:Name="CancelImportButton" Content="Cancel" Margin="0,0,10,0"/><Button x:Name="ConfirmImportButton" Content="Install" Style="{StaticResource Primary}"/></StackPanel>
    </Grid>
   </Border>
  </Border>
 </Grid>
</Window>
